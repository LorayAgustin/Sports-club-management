package views

import (
	sqlc "cl_gst/db/sqlc"
)

// Usuarios recibe el título y el listado de usuarios
templ UsuariosPage(title string, usuarios []sqlc.Usuario) {
	@Layout(title, UsuarioContent(title, usuarios))
}

templ UsuarioContent(title string, usuarios []sqlc.Usuario) {
	<header class="header-principal">
		<div class="header-contenido">
			<div>
				<h1>Gestión del Club Deportivo</h1>
				<p class="subtitulo-header">Administración de usuarios</p>
			</div>
			<a href="/" class="btn-volver">← Volver al Menú Principal</a>
		</div>
	</header>

	<main class="contenedor-principal layout-abm">
		<!-- Tarjeta 1: Formulario de Alta -->
		<section class="tarjeta-seccion tarjeta-formulario">
			@UsuarioForm()
		</section>

		<!-- Tarjeta 2: Listado de Usuarios -->
		<section class="tarjeta-seccion tarjeta-listado">
			@UsuariosList(usuarios)
		</section>
	</main>
}