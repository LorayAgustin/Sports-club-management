package views

// SocioForm renderiza el formulario de alta de socio
templ SocioForm() {
	<div class="form-container">
		<div class="form-header">
			<h2>Agregar Nuevo Socio</h2>
			<p class="descripcion-seccion">Vinculá un usuario existente al padrón del club mediante su DNI.</p>
		</div>

		<form id="form-socio" class="form-flex" action="/socios" method="POST">
			<div class="campo-grupo">
				<label for="id_usuario-socio">ID de Usuario</label>
				<input
					type="number"
					id="id_usuario-socio"
					name="id_usuario"
					placeholder="Ej: 1"
					min="1"
					required
				/>
				<span class="input-hint">Debe corresponder a un usuario previamente registrado.</span>
			</div>

			<div class="campo-grupo">
				<label for="dni-socio">DNI</label>
				<input
					type="text"
					id="dni-socio"
					name="dni"
					placeholder="Ej: 35123456"
					required
				/>
			</div>

			<div class="campo-grupo">
				<label for="fechaAlta-socio">Fecha de Alta</label>
				<input
					type="date"
					id="fechaAlta-socio"
					name="fechaAlta"
				/>
				<span class="input-hint">Opcional: si se deja vacío, se toma la fecha actual.</span>
			</div>

			<button type="submit" id="agregarSocio" class="btn-primario">
				+ Registrar Socio
			</button>
		</form>
	</div>
}