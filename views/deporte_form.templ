package views

// DeporteForm renderiza el formulario de alta de deporte
templ DeporteForm() {
	<div class="form-container">
		<h2>Agregar Nuevo Deporte</h2>
		<form id="form-deporte" class="form-flex" action="/deportes" method="POST">
			<label for="nombre-deporte">Nombre del Deporte:</label>
			<input
				type="text"
				id="nombre-deporte"
				name="nombre"
				placeholder="Ej: Fútbol, Rugby, Basquet..."
				required
			/>
			<button type="submit" id="agregarDeporte" class="btn-primario">
				Agregar Deporte
			</button>
		</form>
	</div>
}