package views

// DeporteForm renderiza el formulario de alta de deporte
templ DeporteForm() {
	<div id="deporte-form-container" class="form-container">
		<div class="form-header">
			<h2>Agregar Nuevo Deporte</h2>
			<p class="descripcion-seccion">Ingresá el nombre de la disciplina o actividad deportiva.</p>
		</div>
		<form class="form-flex" hx-post="/deportes" hx-target="#deportes-list-container" hx-swap="outerHTML">
			<div class="campo-grupo">
				<label for="nombre-deporte">Nombre del Deporte</label>
				<input type="text" id="nombre-deporte" name="nombre" placeholder="Ej: Fútbol, Rugby, Basquet..." required />
				<span class="input-hint">Ejemplo: Tenis, Natación, Vóley, Gimnasia.</span>
			</div>

			<button type="submit" id="agregarDeporte" class="btn-primario">
				+ Agregar Deporte
			</button>
		</form>
	</div>
}

templ DeporteFormOOB() {
	<div hx-swap-oob="outerHTML:#deporte-form-container">
		@DeporteForm()
	</div>
}