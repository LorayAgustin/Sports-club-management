package views

import (
	"fmt"
	sqlc "cl_gst/db/sqlc"
)

// InscripcionesList renderiza el listado de inscripciones del club
templ InscripcionesList(inscripciones []sqlc.Inscripcione, socios []sqlc.Socio, usuarios []sqlc.Usuario, categorias []sqlc.Categoria, deportes []sqlc.Deporte) {
	<div id="inscripciones-list-container" class="listado-container">
		<div class="listado-header">
			<h2>Inscripciones Registradas</h2>
			<span class="badge-contador">{ fmt.Sprintf("%d registradas", len(inscripciones)) }</span>
		</div>

		if len(inscripciones) == 0 {
			<div class="empty-state">
				<div class="empty-icon">📝</div>
				<h3>No hay inscripciones registradas</h3>
				<p>Completá el formulario de la izquierda para registrar la primera inscripción.</p>
			</div>
		} else {
			<div class="tabla-responsive">
				<table class="tabla-custom">
					<thead>
						<tr>
							<th>ID</th>
							<th>Socio</th>
							<th>Categoría</th>
							<th>Inscripción</th>
							<th>Estado</th>
							<th>Baja</th>
							<th class="texto-derecha">Acciones</th>
						</tr>
					</thead>
					<tbody>
						for _, i := range inscripciones {
							<tr>
								<td><span class="id-tag">#{ fmt.Sprintf("%d", i.IDInscripcion) }</span></td>
								<td><span class="badge badge-user">{ObtenerDetalleSocio(i.IDSocio, socios, usuarios)}</span></td>
								<td><span class="badge badge-admin">{ObtenerDetalleCategoria(i.IDCategoria, categorias, deportes)}</span></td>
								<td class="col-secundaria">{ i.Fechainscripcion.Format("02/01/2006") }</td>
								<td>
									if i.Estado == "Activa" {
										<span class="badge badge-activo">Activa</span>
									} else {
										<span class="badge badge-baja">{ i.Estado }</span>
									}
								</td>
								<td class="col-secundaria">
									if i.Fechabaja.Valid {
										{ i.Fechabaja.Time.Format("02/01/2006") }
									} else {
										<span>—</span>
									}
								</td>
								<td class="col-acciones texto-derecha">
									<button type="submit" class="btn-eliminar" hx-delete={ fmt.Sprintf("/inscripciones?id=%d", i.IDInscripcion) } hx-target="closest tr" hx-swap="outerHTML" hx-confirm="¿Seguro que deseas eliminar esta inscripción?">
										Eliminar
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}