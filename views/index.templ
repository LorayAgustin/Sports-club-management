package views

// IndexPage renderiza el menú principal del club
templ IndexPage(title string) {
	@Layout(title, indexContent(title))
}

templ indexContent(title string) {
	<header class="header-principal">
		<h1>Gestión del Club Deportivo</h1>
	</header>
	<main class="contenedor-principal">
		<section class="tarjeta-seccion">
			<h2>Panel de Administración</h2>
			<p>Seleccioná la sección que desees gestionar:</p>
			<div class="menu-navegacion">
				<a href="/deportes" class="btn-navegacion">⚽ Gestión de Deportes</a>
				<a href="/predios" class="btn-navegacion">🏟️ Gestión de Predios</a>
				<a href="/usuarios" class="btn-navegacion">👤 Gestión de Usuarios</a>
				<a href="/categorias" class="btn-navegacion">🏆 Gestión de Categorías</a>
				<a href="/socios" class="btn-navegacion">🪪 Gestión de Socios</a>
			</div>
		</section>
	</main>
}