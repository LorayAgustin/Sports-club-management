package views

import (
	sqlc "cl_gst/db/sqlc"
)

// InscripcionesPage recibe el título, las inscripciones y las listas para los desplegables del formulario
templ InscripcionesPage(title string, inscripciones []sqlc.Inscripcione, socios []sqlc.Socio, usuarios []sqlc.Usuario, categorias []sqlc.Categoria, deportes []sqlc.Deporte) {
	@Layout(title, InscripcionContent(title, inscripciones, socios, usuarios, categorias, deportes))
}

templ InscripcionContent(title string, inscripciones []sqlc.Inscripcione, socios []sqlc.Socio, usuarios []sqlc.Usuario, categorias []sqlc.Categoria, deportes []sqlc.Deporte) {
	<header class="header-principal">
		<div class="header-contenido">
			<div>
				<h1>Gestión del Club Deportivo</h1>
				<p class="subtitulo-header">Administración de inscripciones de socios a disciplinas y categorías</p>
			</div>
			<a href="/" class="btn-volver">← Volver al Menú Principal</a>
		</div>
	</header>

	<main class="layout-abm">
		<!-- Tarjeta 1: Formulario de Alta -->
		<section class="tarjeta-seccion">
			@InscripcionForm(socios, usuarios, categorias, deportes)
		</section>

		<!-- Tarjeta 2: Listado de Inscripciones -->
		<section class="tarjeta-seccion">
			@InscripcionesList(inscripciones, socios, usuarios, categorias, deportes)
		</section>
	</main>
}