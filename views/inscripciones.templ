package views

import (
	sqlc "cl_gst/db/sqlc"
)

// InscripcionesPage recibe el título, las inscripciones y las listas para los desplegables del formulario
templ InscripcionesPage(title string, inscripciones []sqlc.Inscripcione, socios []sqlc.Socio, categorias []sqlc.Categoria) {
	@Layout(title, InscripcionContent(title, inscripciones, socios, categorias))
}

templ InscripcionContent(title string, inscripciones []sqlc.Inscripcione, socios []sqlc.Socio, categorias []sqlc.Categoria) {
	<header class="header-principal">
		<h1>Gestión del Club Deportivo</h1>
	</header>
	<main class="contenedor-principal">
		<section class="tarjeta-seccion">
			<h2>{ title }</h2>
			@InscripcionForm(socios, categorias)
			<hr/>
			@InscripcionesList(inscripciones)
		</section>
	</main>
}