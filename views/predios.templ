package views

import (
	sqlc "cl_gst/db/sqlc"
)

// IndexPage recibe el título, el listado de deportes
templ PrediosPage(title string, predios []sqlc.Predio) {
	@Layout(title, PredioContent(title, predios))
}

templ PredioContent(title string, predios []sqlc.Predio) {
	<header class="header-principal">
		<div class="header-contenido">
			<div>
				<h1>Gestión del Club Deportivo</h1>
				<p class="subtitulo-header">Administración de sedes, canchas e instalaciones del club</p>
			</div>
			<a href="/" class="btn-volver">← Volver al Menú Principal</a>
		</div>
	</header>

	<main class="layout-abm">
		<!-- Tarjeta 1: Formulario de Alta -->
		<section class="tarjeta-seccion">
			@PredioForm()
		</section>

		<!-- Tarjeta 2: Listado de Predios -->
		<section class="tarjeta-seccion">
			@PrediosList(predios)
		</section>
	</main>
}