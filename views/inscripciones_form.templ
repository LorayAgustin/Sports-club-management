package views

import (
	"fmt"
	sqlc "cl_gst/db/sqlc"
)

// InscripcionForm renderiza el formulario de alta de inscripción
templ InscripcionForm(socios []sqlc.Socio, usuarios []sqlc.Usuario, categorias []sqlc.Categoria, deportes []sqlc.Deporte) {
	<div id="inscripcion-form-container" class="form-container">
		<div class="form-header">
			<h2>Agregar Nueva Inscripción</h2>
			<p class="descripcion-seccion">Asigná un socio a una categoría y definí el estado de su inscripción.</p>
		</div>

		<form id="form-inscripcion" class="form-flex" hx-post="/inscripciones" hx-target="#inscripciones-list-container" hx-swap="outerHTML">
			<div class="campo-grupo">
				<label for="id-socio">Socio</label>
				<select id="id-socio" name="id_socio" required class="select-estilizado">
					<option value="" disabled selected>Seleccione un socio...</option>
					for _, s := range socios {
						<option value={ fmt.Sprintf("%d", s.IDSocio) }>
							{ fmt.Sprintf("DNI: %s - %s - #%d", s.Dni, ObtenerNombreUsuario(s.IDUsuario, usuarios), s.IDSocio) }
						</option>
					}
				</select>
			</div>

			<div class="campo-grupo">
				<label for="id-categoria">Categoría</label>
				<select id="id-categoria" name="id_categoria" required class="select-estilizado">
					<option value="" disabled selected>Seleccione una categoría...</option>
					for _, c := range categorias {
						<option value={ fmt.Sprintf("Deporte: %s - %s - #%d", ObtenerNombreDeporte(c.IDDeporte, deportes), c.Nombre, c.IDCategoria) }>
						</option>
					}
				</select>
			</div>

			<div class="campo-grupo">
				<label for="fecha-inscripcion">Fecha de Inscripción</label>
				<input
					type="date"
					id="fecha-inscripcion"
					name="fecha_inscripcion"
					required
				/>
			</div>

			<div class="campo-grupo">
				<label for="estado">Estado</label>
				<select id="estado" name="estado" required class="select-estilizado">
					<option value="Activa" selected>Activa</option>
					<option value="Inactiva">Inactiva</option>
				</select>
			</div>

			<div class="campo-grupo">
				<label for="fecha-baja">Fecha de Baja (Opcional)</label>
				<input
					type="date"
					id="fecha-baja"
					name="fecha_baja"
				/>
				<span class="input-hint">Completar únicamente si la inscripción ya finalizó.</span>
			</div>

			<button type="submit" id="agregarInscripcion" class="btn-primario">
				{ "+ Agregar Inscripción" }
			</button>
		</form>
	</div>
}

templ InscripcionFormOOB(socios []sqlc.Socio, usuarios []sqlc.Usuario, categorias []sqlc.Categoria, deportes []sqlc.Deporte) { 
	<div hx-swap-oob="outerHTML:#inscripcion-form-container"> 
		@InscripcionForm(socios, usuarios, categorias, deportes) 
	</div> 
}