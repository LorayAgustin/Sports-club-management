package views

import (
	"fmt"
	sqlc "cl_gst/db/sqlc"
)

// Resolver la obtencion del nombre de la Categoria
func obtenerNombreCategoria(idCat int32, categorias []sqlc.Categoria) string { 
	for _, c := range categorias { 
		if c.IDCategoria == idCat { 
			// Nombre e ID entre paréntesis 
			return fmt.Sprintf("%s (#%d)", c.Nombre, c.IDCategoria) 
		} 
	} 
	return "Sin categoría" 
}

// Resolver la obtencion del nombre del Predio
func obtenerNombrePredio(idPredio int32, predios []sqlc.Predio) string { 
	for _, p := range predios { 
		if p.IDPredio == idPredio { 
			// Nombre e ID entre paréntesis
			return fmt.Sprintf("%s (#%d)", p.Nombre, p.IDPredio) 
		} 
	} 
	return "Sin predio" 
}

// PracticasList renderiza el listado de prácticas deportivas
// PracticasList renderiza el listado de horarios de prácticas con Empty State y badges
templ PracticasList(practicas []sqlc.Practica, categorias []sqlc.Categoria, predios []sqlc.Predio) {
	<div id="practicas-list-container" class="listado-container">
		<div class="listado-header">
			<h2>Horarios de Prácticas</h2>
			<span class="badge-contador">{ fmt.Sprintf("%d registradas", len(practicas)) }</span>
		</div>

		if len(practicas) == 0 {
			<div class="empty-state">
				<div class="empty-icon">📋</div>
				<h3>No hay prácticas registradas</h3>
				<p>Completá el formulario de la izquierda para programar el primer horario.</p>
			</div>
		} else {
			<div class="tabla-responsive">
				<table class="tabla-custom">
					<thead>
						<tr>
							<th>ID</th>
							<th>Categoría</th>
							<th>Predio</th>
							<th>Día</th>
							<th>Franja Horaria</th>
							<th class="texto-derecha">Acciones</th>
						</tr>
					</thead>
					<tbody>
						for _, p := range practicas {
							<tr>
								<td><span class="id-tag">#{ fmt.Sprintf("%d", p.IDPractica) }</span></td>
								<td><span class="badge badge-admin">{obtenerNombreCategoria(p.IDCategoria, categorias)}</span></td>
								<td><span class="badge badge-user">{obtenerNombrePredio(p.IDPredio, predios)}</span></td>
								<td class="col-destacada">{ fmt.Sprintf("%v", p.Diasemana) }</td>
								<td>
									<span class="horario-tag">
										🕒 { fmt.Sprintf("%s - %s", p.Horainicio.Format("15:04"), p.Horafin.Format("15:04"))}
									</span>
								</td>
								<td class="col-acciones texto-derecha">
									<button type="button" class="btn-eliminar" hx-delete={ fmt.Sprintf("/practicas?id=%d", p.IDPractica) } hx-target="closest tr" hx-swap="outerHTML" hx-confirm="¿Seguro que deseas eliminar este horario de práctica?">
										Eliminar
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}