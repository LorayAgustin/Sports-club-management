package views

import (
	"fmt"
	sqlc "cl_gst/db/sqlc"
)

// DeportesList renderiza el listado de disciplinas deportivas
templ DeportesList(deportes []sqlc.Deporte) {
    <div id="deportes-list-container">
        <h2 class="titulo-lista">Disciplinas Deportivas</h2>
        if len(deportes) == 0 {
            <p class="mensaje-vacio">No hay deportes registrados en el club actualmente.</p>
        } else {
            <div class="grid-deportes">
                for _, d := range deportes {
                    <div class="tarjeta-deporte-row">
                        <!-- Columna ID -->
                        <div class="col-seccion id-seccion">
                            <span class="etiqueta">ID</span>
                            <span class="valor-id">#{ fmt.Sprintf("%d", d.IDDeporte) }</span>
                        </div>
                        
                        <!-- Columna Nombre -->
                        <div class="col-seccion nombre-seccion">
                            <span class="etiqueta">Deporte</span>
                            <span class="valor-nombre">{ d.Nombre }</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}