package views

import (
	"fmt"
	sqlc "cl_gst/db/sqlc"
)

// DeportesList renderiza el listado de disciplinas deportivas
templ DeportesList(deportes []sqlc.Deporte) {
	<div id="deportes-list-container" class="listado-container">
		<div class="listado-header">
			<h2>Disciplinas Deportivas</h2>
			<span class="badge-contador">{ fmt.Sprintf("%d registradas", len(deportes)) }</span>
		</div>

		if len(deportes) == 0 {
			<div class="empty-state">
				<div class="empty-icon">⚽</div>
				<h3>No hay deportes registrados</h3>
				<p>Completá el formulario de la izquierda para dar de alta la primera disciplina.</p>
			</div>
		} else {
			<div class="tabla-responsive">
				<table class="tabla-custom">
					<thead>
						<tr>
							<th>ID</th>
							<th>Disciplina / Nombre</th>
							<th class="texto-derecha">Acciones</th>
						</tr>
					</thead>
					<tbody>
						for _, d := range deportes {
							<tr>
								<td><span class="id-tag">#{ fmt.Sprintf("%d", d.IDDeporte) }</span></td>
								<td class="col-destacada">
									<span class="icono-tabla">⚽</span> { d.Nombre }
								</td>
								<td class="col-acciones texto-derecha">
									<form action={ templ.SafeURL(fmt.Sprintf("/deportes/eliminar?id=%d", d.IDDeporte)) } method="POST" class="form-inline">
										<button type="submit" class="btn-eliminar" onclick="return confirm('¿Seguro que deseas eliminar esta disciplina deportiva?');">
											Eliminar
										</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}