package views

import (
	sqlc "cl_gst/db/sqlc"
)

// Deportes recibe el título, el listado de deportes
templ DeportesPage(title string, deportes []sqlc.Deporte) {
	@Layout(title, DeporteContent(title, deportes))
}

templ DeporteContent(title string, deportes []sqlc.Deporte) {
	<header class="header-principal">
		<div class="header-contenido">
			<div>
				<h1>Gestión del Club Deportivo</h1>
				<p class="subtitulo-header">Administración de disciplinas, actividades y deportes del club</p>
			</div>
			<a href="/" class="btn-volver">← Volver al Menú Principal</a>
		</div>
	</header>

	<main class="layout-abm">
		<!-- Tarjeta 1: Formulario de Alta -->
		<section class="tarjeta-seccion">
			@DeporteForm()
		</section>

		<!-- Tarjeta 2: Listado de Deportes -->
		<section class="tarjeta-seccion">
			@DeportesList(deportes)
		</section>
	</main>
}