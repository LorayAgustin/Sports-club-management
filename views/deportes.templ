package views

import (
	sqlc "cl_gst/db/sqlc"
)

// IndexPage recibe el título, el listado de deportes
templ DeportesPage(title string, deportes []sqlc.Deporte) {
	@Layout(title, DeporteContent(title, deportes))
}

templ DeporteContent(title string, deportes []sqlc.Deporte) {
	<header class="header-principal">
		<h1>Gestión del Club Deportivo</h1>
		<h2>{ title }</h2>
		<!-- Botón para volver al menú principal -->
		<a href="/" class="btn-volver">← Volver al Menú Principal</a>
	</header>
	
	<main class="contenedor-principal">
		
		<!-- Bloque separado 1: Formulario para añadir -->
		<section class="tarjeta-seccion">
			@DeporteForm()
		</section>

		<!-- Bloque separado 2: Lista de deportes -->
		<section class="tarjeta-seccion">
			@DeportesList(deportes)
		</section>
		
	</main>
}