package views

import (
	sqlc "cl_gst/db/sqlc"
)

// SociosPage recibe el título y el listado de socios
templ SociosPage(title string, socios []sqlc.Socio) {
	@Layout(title, SocioContent(title, socios))
}

templ SocioContent(title string, socios []sqlc.Socio) {
	<header class="header-principal">
		<div class="header-contenido">
			<div>
				<h1>Gestión del Club Deportivo</h1>
				<p class="subtitulo-header">Administración del padrón de socios, altas y estados de afiliación</p>
			</div>
			<a href="/" class="btn-volver">← Volver al Menú Principal</a>
		</div>
	</header>

	<main class="layout-abm">
		<!-- Tarjeta 1: Formulario de Alta -->
		<section class="tarjeta-seccion">
			@SocioForm()
		</section>

		<!-- Tarjeta 2: Listado de Socios -->
		<section class="tarjeta-seccion">
			@SociosList(socios)
		</section>
	</main>
}