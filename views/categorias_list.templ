package views

import (
	"fmt"
	sqlc "cl_gst/db/sqlc"
)

func obtenerNombreDeporte(idDeporte int32, deportes []sqlc.Deporte) string {
	for _, d := range deportes { 
		if d.IDDeporte == idDeporte { 
			return d.Nombre 
		} 
	} 
	return "No asignado" 
}

// CategoriasList renderiza el listado de categorías del club
templ CategoriasList(categorias []sqlc.Categoria, deportes []sqlc.Deporte) {
	<div id="categorias-list-container" class="listado-container">
		<div class="listado-header">
			<h2>Categorías Registradas</h2>
			<span class="badge-contador">{ fmt.Sprintf("%d registradas", len(categorias)) }</span>
		</div>

		if len(categorias) == 0 {
			<div class="empty-state">
				<div class="empty-icon">🏆</div>
				<h3>No hay categorías registradas</h3>
				<p>Completá el formulario de la izquierda para dar de alta la primera categoría.</p>
			</div>
		} else {
			<div class="tabla-responsive">
				<table class="tabla-custom">
					<thead>
						<tr>
							<th>ID</th>
							<th>Categoría</th>
							<th>Deporte Asociado</th>
							<th class="texto-derecha">Acciones</th>
						</tr>
					</thead>
					<tbody>
						for _, c := range categorias {
							<tr>
								<td><span class="id-tag">#{ fmt.Sprintf("%d", c.IDCategoria) }</span></td>
								<td class="col-destacada">
									<span class="icono-tabla">🏆</span> { c.Nombre }
								</td>
								<td>
									<span class="badge badge-admin">
										{ obtenerNombreDeporte(c.IDDeporte, deportes) }
									</span>
								</td>
								<td class="col-acciones texto-derecha">
									<button
										type="button"
										class="btn-eliminar"
										hx-delete={ fmt.Sprintf("/categorias?id=%d", c.IDCategoria) }
										hx-target="closest tr"
										hx-swap="outerHTML"
										hx-confirm="¿Estás seguro de eliminar esta categoría?"
									>
										Eliminar
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}